{
  "name": "Telegram Approval Webhook (scoped to one audit run)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "callback_query"
        ],
        "additionalFields": {}
      },
      "id": "a1f3c2d4-1111-4a7e-9b01-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        100
      ],
      "webhookId": "b7e2a9c1-5d4f-4e3a-8c21-telegramapprove",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// The run id comes from the button the approver tapped, never from the card text.\nconst q = $json.callback_query || {};\nconst m = /^(approve|deny):([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/.exec(q.data || '');\nreturn [{ json: {\n  valid: Boolean(m && q.from && Number.isInteger(q.from.id)),\n  decision: m ? (m[1] === 'approve' ? 'APPROVE' : 'DENY') : null,\n  run_id: m ? m[2] : null,\n  telegram_user_id: q.from ? q.from.id : null,\n  query_id: q.id || null,\n  chat_id: q.message && q.message.chat ? q.message.chat.id : null,\n} }];"
      },
      "name": "Parse Button",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ],
      "id": "parse-button"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "valid-button?-c",
              "leftValue": "={{ $json.valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Valid Button?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        100
      ],
      "id": "valid-button?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=REPLACE_WITH_SUPABASE_URL/rest/v1/rpc/decide_audit_run",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_run_id: $('Parse Button').item.json.run_id, p_decision: $('Parse Button').item.json.decision, p_telegram_user_id: $('Parse Button').item.json.telegram_user_id }) }}",
        "options": {}
      },
      "name": "Decide in Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase account"
        }
      },
      "id": "decide-in-supabase"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "decision-recorded?-c",
              "leftValue": "={{ $json.ok }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Decision Recorded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "decision-recorded?"
    },
    {
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{ $('Parse Button').item.json.query_id }}",
        "additionalFields": {
          "text": "={{ $('Decide in Supabase').item.json.decision === 'APPROVED' ? 'Approved.' : 'Denied.' }}"
        }
      },
      "name": "Answer Recorded",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        -100
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      },
      "id": "answer-recorded"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "approved?-c",
              "leftValue": "={{ $('Decide in Supabase').item.json.decision }}",
              "rightValue": "APPROVED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        -100
      ],
      "id": "approved?"
    },
    {
      "parameters": {
        "sendTo": "REPLACE_WITH_FINANCE_EMAIL",
        "subject": "=Approved: catch-up invoices for {{ $('Decide in Supabase').item.json.client_name }} ({{ '$' + Number($('Decide in Supabase').item.json.total).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) }})",
        "emailType": "text",
        "message": "=Finance team,\n\nPlease issue catch-up invoices for {{ $('Decide in Supabase').item.json.client_name }} (contract {{ $('Decide in Supabase').item.json.contract_id }}).\n\n{{ $('Decide in Supabase').item.json.rows.map(r => r.period + '   ' + r.invoices + '   ' + '$' + Number(r.amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })).join('\\n') }}\nTotal: {{ '$' + Number($('Decide in Supabase').item.json.total).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) }} across {{ $('Decide in Supabase').item.json.count }} month(s)\n\nWhy, from the signed contract:\n{{ $('Decide in Supabase').item.json.reasons.map(r => '- ' + r.reason + ': ' + '$' + Number(r.amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })).join('\\n') }}\n\nApproved by {{ $('Decide in Supabase').item.json.approver }}, {{ $now.toFormat('MMM d, yyyy h:mm a ZZZZ') }}. Audit run {{ String($('Decide in Supabase').item.json.run_id).slice(0, 8) }}.\n\nEach amount is tied to a verified clause in the signed contract. Month-by-month detail is in the ledger.\n\nSent automatically by System #001: Deterministic Billing Reconciler.",
        "options": {
          "appendAttribution": false
        }
      },
      "name": "Email Finance",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1540,
        -200
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      },
      "id": "email-finance"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Parse Button').item.json.chat_id }}",
        "text": "=✅ Approved {{ $('Decide in Supabase').item.json.count }} month(s) for {{ $('Decide in Supabase').item.json.client_name }}, totaling {{ '$' + Number($('Decide in Supabase').item.json.total).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) }}. Finance has been emailed. Only this audit run was affected.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "name": "Send Approval Confirmation",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1760,
        -200
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      },
      "id": "send-approval-confirmation"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Parse Button').item.json.chat_id }}",
        "text": "=❌ Denied {{ $('Decide in Supabase').item.json.count }} month(s) for {{ $('Decide in Supabase').item.json.client_name }}. Nothing will be billed. Only this audit run was affected.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "name": "Send Denial Confirmation",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1540,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      },
      "id": "send-denial-confirmation"
    },
    {
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{ $('Parse Button').item.json.query_id }}",
        "additionalFields": {
          "text": "={{ $('Decide in Supabase').item.json.reason || 'Nothing changed.' }}",
          "showAlert": true
        }
      },
      "name": "Answer Rejected",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        100
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      },
      "id": "answer-rejected"
    },
    {
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{ $('Parse Button').item.json.query_id }}",
        "additionalFields": {
          "text": "This button is not valid. Nothing changed.",
          "showAlert": true
        }
      },
      "name": "Answer Invalid Button",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        240
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      },
      "id": "answer-invalid-button"
    }
  ],
